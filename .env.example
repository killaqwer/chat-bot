# Переименуй этот файл в .env и заполни

# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# id людей, у кого доступ к базе в личке бота (через запятую). Узнать: написать боту /myid
# Если оставить пустым — доступ будет у любого, кто найдёт бота.
ADMIN_IDS=

# id вашего чата (узнать: /chatid в чате). Пусто = бот модерирует любой чат, куда его добавят.
GROUP_IDS=

# Нейросеть для сортировки сообщений (любой OpenAI-совместимый API).
# По умолчанию Groq: ключ на console.groq.com (есть бесплатный лимит).
# Без ключа бот НЕ удаляет сообщения, только сохраняет файлы.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Если модель перестанет работать — возьми актуальное название из списка моделей Groq
LLM_MODEL=llama-3.3-70b-versatile

# О чём ваш чат — по этому описанию нейросеть решает, что полезно, а что флуд
CHAT_TOPIC=заработок на нейросетях (способы, схемы, инструменты, промпты, кейсы) и наши проекты: игра в Roblox (режимы, идеи, разработка), TikTok-аккаунт

# Как часто проверять чат, в минутах
CHECK_INTERVAL_MIN=60
